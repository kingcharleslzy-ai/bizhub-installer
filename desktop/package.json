{
  "name": "bizhub-desktop",
  "productName": "BizHub Desktop",
  "version": "0.1.0",
  "description": "Customer-neutral BizHub desktop shell",
  "main": "electron/main.cjs",
  "author": "kingcharleslzy-ai",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "scripts": {
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "build": "vite build",
    "build:runtime": ".runtime-venv/bin/python runtime/build_local_runtime.py --python .runtime-venv/bin/python",
    "make": "npm run build:runtime && npm run build && electron-forge make --platform=darwin --arch=arm64",
    "package": "npm run build:runtime && npm run build && electron-forge package --platform=darwin --arch=arm64",
    "smoke:cloud": "npm run build && node scripts/cloud-smoke.mjs",
    "smoke:local": "node scripts/local-runtime-smoke.mjs",
    "smoke:local-shell": "npm run build && node scripts/local-shell-smoke.mjs",
    "smoke:packaged": "node scripts/cloud-smoke.mjs",
    "start": "npm run build && electron-forge start",
    "test": "node --test test/*.test.mjs",
    "verify:artifact": "node scripts/verify-packaged-artifact.mjs",
    "verify:boundary": "node scripts/verify-d2-boundary.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/asar": "3.4.1",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "44.0.0",
    "vite": "8.2.2",
    "vue": "3.5.41"
  }
}
