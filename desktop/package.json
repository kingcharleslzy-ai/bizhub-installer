{
  "name": "bizhub-desktop",
  "productName": "BizHub Desktop",
  "version": "0.1.16",
  "description": "Customer-neutral BizHub desktop shell",
  "main": "electron/main.cjs",
  "author": "kingcharleslzy-ai",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "scripts": {
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "build": "vite build",
    "build:runtime": ".runtime-venv/bin/python runtime/build_local_runtime.py --python .runtime-venv/bin/python && node scripts/verify-runtime-pack.mjs",
    "make": "npm run prepare:runtime && npm run build && electron-forge make --platform=darwin --arch=arm64",
    "make:macos-release": "npm run build && electron-forge package --platform=darwin --arch=arm64",
    "make:windows": "npm run prepare:runtime && npm run build && electron-forge make --platform=win32 --arch=x64",
    "make:windows-release": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "package": "npm run prepare:runtime && npm run build && electron-forge package --platform=darwin --arch=arm64",
    "prepare:runtime": "node scripts/prepare-runtime-pack.mjs",
    "smoke:cloud": "npm run build && node scripts/cloud-smoke.mjs",
    "smoke:account-flow": "npm run build && node scripts/account-flow-smoke.mjs",
    "smoke:local": "node scripts/local-runtime-smoke.mjs",
    "smoke:local-shell": "npm run build && node scripts/local-shell-smoke.mjs",
    "smoke:runtime-tamper": "node scripts/runtime-pack-tamper-smoke.mjs",
    "smoke:packaged": "node scripts/cloud-smoke.mjs",
    "start": "npm run build && electron-forge start",
    "test": "node --test test/*.test.mjs",
    "verify:artifact": "node scripts/verify-packaged-artifact.mjs",
    "verify:boundary": "node scripts/verify-d2-boundary.mjs",
    "verify:runtime-archive": "node scripts/verify-fixed-runtime-archive.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.0",
    "@electron/windows-sign": "1.2.2",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "44.0.0",
    "extract-zip": "file:vendor/extract-zip-safe",
    "vite": "8.2.2",
    "vue": "3.5.41"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "extract-zip": "$extract-zip",
    "tmp": "0.2.7"
  }
}
