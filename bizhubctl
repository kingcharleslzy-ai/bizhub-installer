VERSION = "0.4.0-preview.4"
CONTAINER = "bizhub"
ROOT = Path(os.getenv("BIZHUBCTL_ROOT", "/")).resolve()
ETC = ROOT / "etc/bizhub"
DATA = ROOT / "var/lib/bizhub"
APP_DATA = DATA / "data"
BACKUPS = ROOT / "var/backups/bizhub"
STATE = DATA / "install-state.json"
CGROUP_ROOT = Path("/sys/fs/cgroup")
PLAN_CONTRACT = "bizhub.install-plan.v1"
DERIVED_EXTENSION_MODE = "read-only-reference"
COMMIT_PATTERN = re.compile(r"^[0-9a-f]{40}$")
IMAGE_ID_PATTERN = re.compile(r"^sha256:[0-9a-f]{64}$")
IMPORT_NAME_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*$")


def now() -> str:
    return datetime.now(UTC).isoformat()


def emit(value: Any) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2))


def run(command: list[str], *, check: bool = True, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=check, text=True, input=input_text, capture_output=True)


def repository_root() -> Path:
    return Path(__file__).resolve().parent


def git_value(*args: str) -> str:
    root = repository_root()
    result = run(["git", "-c", f"safe.directory={root}", "-C", str(root), *args])
    return result.stdout.strip()


def source_identity() -> dict[str, str]:
    commit = git_value("rev-parse", "HEAD")
    if len(commit) != 40:
        raise RuntimeError("repository HEAD is not a full commit")
    if git_value("status", "--porcelain"):
        raise RuntimeError("repository worktree must be clean before planning or installing")
    tags = git_value("tag", "--points-at", "HEAD").splitlines()
    tag = next((item for item in tags if item == f"v{VERSION}"), "")
    if not tag:
        raise RuntimeError(f"HEAD must be the fixed v{VERSION} release tag")
    remote = git_value("remote", "get-url", "origin")
    accepted = {
        "https://github.com/kingcharleslzy-ai/bizhub-installer",
        "https://github.com/kingcharleslzy-ai/bizhub-installer.git",
        "git@github.com:kingcharleslzy-ai/bizhub-installer",
        "git@github.com:kingcharleslzy-ai/bizhub-installer.git",
    }
    if remote not in accepted:
        raise RuntimeError("origin is not the canonical BizHub public repository")
    return {"repository": remote, "release_tag": tag, "commit": commit, "tree": git_value("rev-parse", "HEAD^{tree}")}


def file_digest(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def application_digest() -> str:
    root = repository_root()
    files = [root / "bizhubctl"]
    files.extend(sorted((root / "app").rglob("*")))
    digest = hashlib.sha256()
    for path in files:
        if not path.is_file() or any(part in {"node_modules", "static", "__pycache__"} for part in path.parts):
            continue
        relative = path.relative_to(root).as_posix()
        digest.update(relative.encode())
        digest.update(b"\0")
        digest.update(bytes.fromhex(file_digest(path)))
    return digest.hexdigest()


def os_release() -> dict[str, str]:
    path = Path("/etc/os-release")
    values: dict[str, str] = {}
    if path.exists():
        for line in path.read_text(encoding="utf-8").splitlines():
            key, marker, value = line.partition("=")
            if marker:
                values[key] = value.strip().strip('"')
    return values


def target_fingerprint() -> str:
    machine_id = Path("/etc/machine-id")
    stable_id = machine_id.read_text(encoding="utf-8").strip() if machine_id.exists() else socket.gethostname()
    payload = f"{stable_id}|{platform.machine()}|{platform.system()}"
    return hashlib.sha256(payload.encode()).hexdigest()


def docker_available() -> tuple[bool, str]:
    executable = shutil.which("docker")
    if not executable:
        return False, "docker executable is unavailable"
    result = run([executable, "version", "--format", "{{.Server.Version}}"], check=False)
    return (result.returncode == 0, result.stdout.strip() or result.stderr.strip())


def preflight_result() -> dict[str, Any]:
    release = os_release()
    docker_ok, docker_detail = docker_available()
    disk = shutil.disk_usage(DATA.parent if DATA.parent.exists() else ROOT)
    cgroup_controllers = CGROUP_ROOT / "cgroup.controllers"
    checks = {
        "ubuntu_24_04": release.get("ID") == "ubuntu" and release.get("VERSION_ID") == "24.04",
        "architecture": platform.machine() in {"x86_64", "aarch64", "arm64"},
        "docker_engine": docker_ok,
        "cgroup_v2": cgroup_controllers.is_file(),
        "disk_free_gib_at_least_10": disk.free >= 10 * 1024**3,
        "root_or_test_prefix": os.geteuid() == 0 or ROOT != Path("/"),
    }
    return {
        "status": "passed" if all(checks.values()) else "failed",
        "checks": checks,
        "details": {
            "os_release": release,
            "docker": docker_detail,
            "cgroup_controllers": (
                cgroup_controllers.read_text(encoding="utf-8").split()
                if cgroup_controllers.is_file()
                else []
            ),
            "disk_free_bytes": disk.free,
        },
        "target_fingerprint": target_fingerprint(),
    }


def canonical(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()


def plan_hash(plan: dict[str, Any]) -> str:
    payload = {key: value for key, value in plan.items() if key != "plan_hash"}
    return hashlib.sha256(canonical(payload)).hexdigest()


def validate_bind(access: str, bind_address: str, hostname: str) -> None:
    if access == "loopback":
        if bind_address != "127.0.0.1" or hostname:
            raise ValueError("loopback access requires 127.0.0.1 and no hostname")
    if access == "private":
        try:
            address = ipaddress.ip_address(bind_address)
        except ValueError as exc:
            raise ValueError("private access requires an explicit private IPv4 address") from exc
        if address.version != 4 or not address.is_private or address.is_loopback or address.is_unspecified:
            raise ValueError("private access requires an explicit non-loopback private IPv4 address")
    if access in {"domain", "cloudflare"} and bind_address != "127.0.0.1":
        raise ValueError("domain and Cloudflare access must bind the application to loopback")
    if access in {"domain", "cloudflare"} and not hostname:
        raise ValueError("domain and Cloudflare access require a hostname")


def resource_limits(memory_mib: int, swap_mib: int, cpu_millicores: int, pids_limit: int) -> dict[str, int]:
    if not 256 <= memory_mib <= 65536:
        raise ValueError("memory limit must be between 256 and 65536 MiB")
    if not 0 <= swap_mib <= 65536:
        raise ValueError("additional swap limit must be between 0 and 65536 MiB")
    if memory_mib + swap_mib > 131072:
        raise ValueError("combined memory and swap limit must not exceed 131072 MiB")
    if not 250 <= cpu_millicores <= 64000:
        raise ValueError("CPU limit must be between 250 and 64000 millicores")
    if not 64 <= pids_limit <= 4096:
        raise ValueError("PID limit must be between 64 and 4096")
    return {
        "memory_mib": memory_mib,
        "swap_mib": swap_mib,
        "cpu_millicores": cpu_millicores,
        "pids_limit": pids_limit,
    }


def expected_docker_resources(instance: dict[str, Any]) -> dict[str, int]:
    limits = instance.get("resource_limits") or {}
    validated = resource_limits(
        int(limits.get("memory_mib", 0)),
        int(limits.get("swap_mib", -1)),
        int(limits.get("cpu_millicores", 0)),
        int(limits.get("pids_limit", 0)),
    )
    return {
        "memory_bytes": validated["memory_mib"] * 1024 * 1024,
        # Docker --memory-swap is the combined memory-plus-swap ceiling. The
        # kernel's cgroup v2 memory.swap.max is the additional swap ceiling.
        "memory_swap_total_bytes": (validated["memory_mib"] + validated["swap_mib"]) * 1024 * 1024,
        "nano_cpus": validated["cpu_millicores"] * 1_000_000,
        "pids_limit": validated["pids_limit"],
    }


def expected_cgroup_resources(instance: dict[str, Any]) -> dict[str, int]:
    limits = instance.get("resource_limits") or {}
    validated = resource_limits(
        int(limits.get("memory_mib", 0)),
        int(limits.get("swap_mib", -1)),
        int(limits.get("cpu_millicores", 0)),
        int(limits.get("pids_limit", 0)),
    )
    return {
        "memory_max_bytes": validated["memory_mib"] * 1024 * 1024,
        "memory_swap_max_bytes": validated["swap_mib"] * 1024 * 1024,
        "cpu_millicores": validated["cpu_millicores"],
        "pids_max": validated["pids_limit"],
    }


def inspect_docker_image(reference: str) -> dict[str, Any]:
    result = run(["docker", "image", "inspect", reference], check=False)
    if result.returncode != 0:
        raise ValueError(f"Docker image is unavailable: {reference}")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ValueError(f"Docker returned invalid image metadata for {reference}") from exc
    if not isinstance(payload, list) or len(payload) != 1 or not isinstance(payload[0], dict):
        raise ValueError(f"Docker image reference must resolve to exactly one image: {reference}")
    image = payload[0]
    if not IMAGE_ID_PATTERN.fullmatch(str(image.get("Id", ""))):
        raise ValueError(f"Docker image has an invalid immutable id: {reference}")
    return image


def image_environment(image: dict[str, Any]) -> dict[str, str]:
    values: dict[str, str] = {}
    config = image.get("Config") or {}
    for item in config.get("Env") or []:
        key, marker, value = str(item).partition("=")
        if marker:
            values[key] = value
    return values


def deployment_image_plan(
    *, candidate_core_image: str | None, candidate_image: str | None, core_revision: str
) -> dict[str, Any]:
    if bool(candidate_core_image) != bool(candidate_image):
        raise ValueError("candidate core and derived image references must be supplied together")
    if not candidate_image:
        return {"mode": "build_public_source", "core_revision": core_revision}
    if not COMMIT_PATTERN.fullmatch(core_revision):
        raise ValueError("core revision must be a full Git commit")

    core = inspect_docker_image(candidate_core_image or "")
    derived = inspect_docker_image(candidate_image)
    core_config = core.get("Config") or {}
    derived_config = derived.get("Config") or {}
    core_labels = core_config.get("Labels") or {}
    derived_labels = derived_config.get("Labels") or {}
    core_environment = image_environment(core)
    derived_environment = image_environment(derived)
    private_revision = str(derived_labels.get("org.opencontainers.image.revision", ""))

    if core_labels.get("org.opencontainers.image.revision") != core_revision:
        raise ValueError("candidate core image revision does not match the planned public source")
    if core_environment.get("BIZHUB_CORE_COMMIT") != core_revision:
        raise ValueError("candidate core image runtime identity does not match the planned public source")
    if derived_labels.get("org.opencontainers.image.base.revision") != core_revision:
        raise ValueError("derived image base revision does not match the planned public source")
    if not COMMIT_PATTERN.fullmatch(private_revision):
        raise ValueError("derived image must declare a full private revision")
    if derived_labels.get("com.bizhub.extension.mode") != DERIVED_EXTENSION_MODE:
        raise ValueError(f"derived image must use extension mode {DERIVED_EXTENSION_MODE}")
    if derived_environment.get("BIZHUB_CORE_COMMIT") != core_revision:
        raise ValueError("derived image inherited core identity does not match the planned public source")
    if derived_environment.get("BIZHUB_EXPECTED_CORE_COMMIT") != core_revision:
        raise ValueError("derived image expected core identity does not match the planned public source")
    if derived_environment.get("BIZHUB_PRIVATE_EXTENSION_COMMIT") != private_revision:
        raise ValueError("derived image private runtime identity does not match its revision label")

    extension_modules = tuple(
        item.strip() for item in derived_environment.get("BIZHUB_EXTENSION_MODULES", "").split(",") if item.strip()
    )
    if not extension_modules or len(extension_modules) != len(set(extension_modules)):
        raise ValueError("derived image must declare unique extension modules")
    if any(not IMPORT_NAME_PATTERN.fullmatch(item) for item in extension_modules):
        raise ValueError("derived image extension modules must be fixed Python import names")

    core_layers = ((core.get("RootFS") or {}).get("Layers") or [])
    derived_layers = ((derived.get("RootFS") or {}).get("Layers") or [])
    if not core_layers or len(derived_layers) <= len(core_layers) or derived_layers[: len(core_layers)] != core_layers:
        raise ValueError("derived image filesystem does not extend the selected core image")
    for key in ("Entrypoint", "Cmd", "Healthcheck", "User", "ExposedPorts"):
        if derived_config.get(key) != core_config.get(key):
            raise ValueError(f"derived image may not replace core runtime field {key}")

    return {
        "mode": "prebuilt_customer_private",
        "core_image_id": core["Id"],
        "candidate_image_id": derived["Id"],
        "core_revision": core_revision,
        "private_revision": private_revision,
        "extension_mode": DERIVED_EXTENSION_MODE,
        "extension_modules": list(extension_modules),
    }


def make_plan(args: argparse.Namespace) -> dict[str, Any]:
    preflight = preflight_result()
    if preflight["status"] != "passed":
        raise RuntimeError(f"target preflight failed: {json.dumps(preflight['checks'], sort_keys=True)}")
    validate_bind(args.access, args.bind_address, args.hostname)
    limits = resource_limits(args.memory_mib, args.swap_mib, args.cpu_millicores, args.pids_limit)
    if args.allow_http_private and args.access != "private":
        raise ValueError("--allow-http-private is valid only for private access")
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", args.profile_id) or len(args.profile_id) > 64:
        raise ValueError("profile id must be a lowercase hyphenated identifier")
    if not (1 <= len(args.legal_name.strip()) <= 160 and 1 <= len(args.display_name.strip()) <= 80):
        raise ValueError("company legal and display names are required")
    if not 1 <= len(args.brand_mark.strip()) <= 6:
        raise ValueError("brand mark must contain 1 to 6 characters")
    if not re.fullmatch(r"[A-Z]{3}", args.currency):
        raise ValueError("currency must be a three-letter uppercase code")
    if not 3 <= len(args.admin_username.strip()) <= 80:
        raise ValueError("administrator username must contain 3 to 80 characters")
    try:
        ZoneInfo(args.timezone)
    except ZoneInfoNotFoundError as exc:
        raise ValueError("timezone must be a valid IANA timezone") from exc
    if args.hostname and not re.fullmatch(r"(?=.{1,253}\Z)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}", args.hostname):
        raise ValueError("hostname is invalid")
    source = source_identity()
    deployment_image = deployment_image_plan(
        candidate_core_image=args.candidate_core_image,
        candidate_image=args.candidate_image,
        core_revision=source["commit"],
    )
    profile = {
        "schema_version": 1,
        "profile_id": args.profile_id,
        "legal_name": args.legal_name.strip(),
        "display_name": args.display_name.strip(),
        "brand_mark": args.brand_mark.strip(),
        "timezone": args.timezone,
        "currency": args.currency,
    }
    external_steps = []
    if args.access == "domain":
        external_steps.append({"owner": "agent", "action": "configure TLS reverse proxy", "template": "deploy/Caddyfile.example"})
    elif args.access == "cloudflare":
        external_steps.append({"owner": "agent", "action": "configure authenticated Cloudflare Tunnel", "template": "deploy/cloudflared-config.example.yaml"})
    plan = {
        "contract": PLAN_CONTRACT,
        "created_at": now(),
        "operation": "install",
        "source": {**source, "application_sha256": application_digest()},
        "deployment_image": deployment_image,
        "target": {
            "fingerprint": target_fingerprint(),
            "platform": "ubuntu-24.04",
            "paths": {"config": str(ETC), "data": str(APP_DATA), "backups": str(BACKUPS), "state": str(STATE)},
        },
        "instance": {
            "container": CONTAINER,
            "bind_address": args.bind_address,
            "port": args.port,
            "access": args.access,
            "hostname": args.hostname,
            "cookie_secure": False if args.access == "loopback" else args.access != "private" or not args.allow_http_private,
            "resource_limits": limits,
        },
        "company_profile": profile,
        "administrator": {"username": args.admin_username.strip(), "password_source": "interactive_tty"},
        "expected_changes": [
            "create protected BizHub config, data, backup, and install-state paths",
            (
                "use the approved immutable customer-private derived image"
                if deployment_image["mode"] == "prebuilt_customer_private"
                else "build one application image from the pinned repository commit"
            ),
            "create the single administrator using a TTY-only password",
            "start one resource-limited loopback/private-bound BizHub container",
        ],
        "external_steps": external_steps,
        "rollback": "retain data and backups; restore the previous image and verified SQLite backup",
    }
    plan["plan_hash"] = plan_hash(plan)
    return plan


def load_plan(path: Path) -> dict[str, Any]:
    plan = json.loads(path.read_text(encoding="utf-8"))
    if plan.get("contract") != PLAN_CONTRACT or plan.get("plan_hash") != plan_hash(plan):
        raise ValueError("install plan is invalid or has been modified")
    return plan


def require_apply_environment(plan: dict[str, Any]) -> None:
    result = preflight_result()
    if result["status"] != "passed":
        raise RuntimeError(f"preflight failed: {json.dumps(result['checks'], sort_keys=True)}")
    if plan["target"]["fingerprint"] != target_fingerprint():
        raise RuntimeError("plan target fingerprint does not match this host")
    source = source_identity()
    for key in ("repository", "commit", "tree"):
        if plan["source"][key] != source[key]:
            raise RuntimeError(f"plan source {key} does not match this checkout")
    if plan["source"]["application_sha256"] != application_digest():
        raise RuntimeError("application files do not match the planned checksum")
    deployment_image = plan.get("deployment_image")
    if not isinstance(deployment_image, dict):
        raise RuntimeError("plan deployment image contract is missing")
    if deployment_image.get("mode") == "prebuilt_customer_private":
        observed = deployment_image_plan(
            candidate_core_image=str(deployment_image.get("core_image_id", "")),
            candidate_image=str(deployment_image.get("candidate_image_id", "")),
            core_revision=source["commit"],
        )
        if observed != deployment_image:
            raise RuntimeError("approved derived image identity has changed")
    elif deployment_image != {"mode": "build_public_source", "core_revision": source["commit"]}:
        raise RuntimeError("plan deployment image contract is invalid")


def require_confirmation(plan: dict[str, Any], supplied: str | None) -> None:
    approved = supplied or input(f"Type plan hash {plan['plan_hash']} to approve: ").strip()
    if not secrets.compare_digest(approved, plan["plan_hash"]):
        raise RuntimeError("plan approval did not match")


def ensure_directories() -> None:
    for path in (ETC, DATA, APP_DATA, BACKUPS):
        path.mkdir(parents=True, exist_ok=True)
        os.chmod(path, 0o750)
    for path in (ETC, DATA, APP_DATA, BACKUPS):
        os.chown(path, 10001, 10001)


def write_secure(path: Path, content: bytes) -> None:
    temporary = path.with_suffix(path.suffix + ".new")
    temporary.write_bytes(content)
    os.chmod(temporary, 0o600)
    os.chown(temporary, 10001, 10001)
    temporary.replace(path)


def image_name(commit: str) -> str:
    return f"bizhub:{commit[:12]}"


def docker_mounts(plan: dict[str, Any]) -> list[str]:
    return [
        "-v", f"{ETC}:/config:ro",
        "-v", f"{APP_DATA}:/data",
        "-v", f"{BACKUPS}:/backups",
        "-e", f"BIZHUB_COOKIE_SECURE={'1' if plan['instance']['cookie_secure'] else '0'}",
    ]


def build_image(plan: dict[str, Any]) -> str:
    deployment_image = plan["deployment_image"]
    if deployment_image["mode"] == "prebuilt_customer_private":
        observed = deployment_image_plan(
            candidate_core_image=deployment_image["core_image_id"],
            candidate_image=deployment_image["candidate_image_id"],
            core_revision=plan["source"]["commit"],
        )
        if observed != deployment_image:
            raise RuntimeError("approved derived image identity has changed before apply")
        return deployment_image["candidate_image_id"]
    image = image_name(plan["source"]["commit"])
    run([
        "docker", "build", "--pull",
        "--build-arg", f"BIZHUB_CORE_COMMIT={plan['source']['commit']}",
        "--label", f"org.opencontainers.image.revision={plan['source']['commit']}",
        "-t", image, "-f", str(repository_root() / "app/Dockerfile"), str(repository_root() / "app"),
    ])
    return image


def container_exists() -> bool:
    return run(["docker", "inspect", CONTAINER], check=False).returncode == 0


def inspect_container() -> dict[str, Any]:
    result = run(["docker", "inspect", CONTAINER], check=False)
    if result.returncode != 0:
        raise RuntimeError("BizHub container does not exist")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError("Docker returned invalid container metadata") from exc
    if not isinstance(payload, list) or len(payload) != 1 or not isinstance(payload[0], dict):
        raise RuntimeError("Docker must return exactly one BizHub container")
    return payload[0]


def _bounded_cgroup_path(container: dict[str, Any]) -> Path:
    state = container.get("State") or {}
    pid = int(state.get("Pid") or 0)
    if pid <= 0:
        raise RuntimeError("BizHub container has no running host PID")
    membership = Path(f"/proc/{pid}/cgroup")
    try:
        lines = membership.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise RuntimeError(f"cannot read container cgroup membership for PID {pid}") from exc
    unified = [line.partition("::")[2] for line in lines if line.startswith("0::")]
    if len(unified) != 1 or not unified[0].startswith("/"):
        raise RuntimeError("container is not attached to one valid cgroup v2 path")
    cgroup_root = CGROUP_ROOT.resolve(strict=True)
    candidate = (cgroup_root / unified[0].lstrip("/")).resolve(strict=True)
    if candidate != cgroup_root and cgroup_root not in candidate.parents:
        raise RuntimeError("container cgroup path escapes the cgroup v2 hierarchy")
    if not candidate.is_dir():
        raise RuntimeError("container cgroup v2 path is not a directory")
    return candidate


def _read_cgroup_value(directory: Path, name: str) -> str:
    path = directory / name
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise RuntimeError(f"cannot read effective cgroup value {name}") from exc
    if not value:
        raise RuntimeError(f"effective cgroup value {name} is empty")
    return value


def _finite_cgroup_integer(value: str, name: str) -> int:
    if value == "max":
        raise RuntimeError(f"effective cgroup value {name} is unlimited")
    try:
        parsed = int(value)
    except ValueError as exc:
        raise RuntimeError(f"effective cgroup value {name} is invalid") from exc
    if parsed < 0:
        raise RuntimeError(f"effective cgroup value {name} is negative")
    return parsed


def effective_cgroup_resources(container: dict[str, Any]) -> dict[str, Any]:
    directory = _bounded_cgroup_path(container)
    memory_raw = _read_cgroup_value(directory, "memory.max")
    swap_raw = _read_cgroup_value(directory, "memory.swap.max")
    cpu_raw = _read_cgroup_value(directory, "cpu.max")
    pids_raw = _read_cgroup_value(directory, "pids.max")
    cpu_parts = cpu_raw.split()
    if len(cpu_parts) != 2:
        raise RuntimeError("effective cgroup value cpu.max is invalid")
    quota = _finite_cgroup_integer(cpu_parts[0], "cpu.max quota")
    period = _finite_cgroup_integer(cpu_parts[1], "cpu.max period")
    if period <= 0:
        raise RuntimeError("effective cgroup cpu.max period must be positive")
    return {
        "cgroup_version": 2,
        "cgroup_path": "/" + directory.relative_to(CGROUP_ROOT.resolve()).as_posix(),
        "memory_max_bytes": _finite_cgroup_integer(memory_raw, "memory.max"),
        "memory_swap_max_bytes": _finite_cgroup_integer(swap_raw, "memory.swap.max"),
        "cpu_quota": quota,
        "cpu_period": period,
        "pids_max": _finite_cgroup_integer(pids_raw, "pids.max"),
        "raw": {
            "memory.max": memory_raw,
            "memory.swap.max": swap_raw,
            "cpu.max": cpu_raw,
            "pids.max": pids_raw,
        },
    }


def container_resource_status(instance: dict[str, Any]) -> dict[str, Any]:
    container = inspect_container()
    host_config = container.get("HostConfig") or {}
    observed_docker = {
        "memory_bytes": int(host_config.get("Memory") or 0),
        "memory_swap_total_bytes": int(host_config.get("MemorySwap") or 0),
        "nano_cpus": int(host_config.get("NanoCpus") or 0),
        "pids_limit": int(host_config.get("PidsLimit") or 0),
    }
    try:
        expected_docker = expected_docker_resources(instance)
        expected_cgroup = expected_cgroup_resources(instance)
        observed_cgroup = effective_cgroup_resources(container)
        cgroup_matches = (
            observed_cgroup["memory_max_bytes"] == expected_cgroup["memory_max_bytes"]
            and observed_cgroup["memory_swap_max_bytes"] == expected_cgroup["memory_swap_max_bytes"]
            and observed_cgroup["pids_max"] == expected_cgroup["pids_max"]
            and observed_cgroup["cpu_quota"] * 1000
            == observed_cgroup["cpu_period"] * expected_cgroup["cpu_millicores"]
        )
    except (OSError, RuntimeError, TypeError, ValueError) as exc:
        return {
            "status": "drift",
            "expected": None,
            "observed": {"docker": observed_docker, "cgroup_v2": None},
            "reason": str(exc),
        }
    expected = {"docker": expected_docker, "cgroup_v2": expected_cgroup}
    observed = {"docker": observed_docker, "cgroup_v2": observed_cgroup}
    status = "ok" if observed_docker == expected_docker and cgroup_matches else "drift"
    return {"status": status, "expected": expected, "observed": observed}


def require_container_resources(instance: dict[str, Any]) -> dict[str, Any]:
    result = container_resource_status(instance)
    if result["status"] != "ok":
        raise RuntimeError(f"container resource limits differ from the approved plan: {json.dumps(result, sort_keys=True)}")
    return result


def container_running() -> bool:
    result = run(["docker", "inspect", "-f", "{{.State.Running}}", CONTAINER], check=False)
    return result.returncode == 0 and result.stdout.strip() == "true"


def start_container(plan: dict[str, Any], image: str) -> None:
    if container_exists():
        run(["docker", "rm", "-f", CONTAINER])
    bind = plan["instance"]["bind_address"]
    port = str(plan["instance"]["port"])
    limits = expected_docker_resources(plan["instance"])
    run([
        "docker", "run", "-d", "--name", CONTAINER, "--restart", "unless-stopped",
        "--read-only", "--tmpfs", "/tmp:rw,noexec,nosuid,size=64m", "--cap-drop", "ALL",
        "--security-opt", "no-new-privileges:true",
        "--memory", str(limits["memory_bytes"]),
        "--memory-swap", str(limits["memory_swap_total_bytes"]),
        "--cpus", f"{limits['nano_cpus'] / 1_000_000_000:g}",
        "--pids-limit", str(limits["pids_limit"]), "-p", f"{bind}:{port}:8080",
        *docker_mounts(plan), image,
    ])


def wait_healthy(plan: dict[str, Any], seconds: int = 60) -> dict[str, Any]:
    url = f"http://{plan['instance']['bind_address']}:{plan['instance']['port']}/api/health"
    if plan["instance"]["bind_address"] in {"0.0.0.0", "::"}:
        url = f"http://127.0.0.1:{plan['instance']['port']}/api/health"
    deadline = time.monotonic() + seconds
    error = "not checked"
    while time.monotonic() < deadline:
        try:
            with urlopen(url, timeout=3) as response:
                body = json.loads(response.read())
                if body.get("status") == "ok":
                    return body
        except (OSError, URLError, ValueError) as exc:
            error = str(exc)
        time.sleep(2)
    logs = run(["docker", "logs", "--tail", "80", CONTAINER], check=False)
    raise RuntimeError(f"health verification timed out: {error}\n{logs.stderr}{logs.stdout}")


def current_state() -> dict[str, Any] | None:
    if not STATE.exists():
        return None
    return json.loads(STATE.read_text(encoding="utf-8"))


def write_state(value: dict[str, Any]) -> None:
    temporary = STATE.with_suffix(".json.new")
    temporary.write_bytes(canonical(value) + b"\n")
    os.chmod(temporary, 0o600)
    if os.geteuid() == 0:
        os.chown(temporary, 0, 0)
    temporary.replace(STATE)


def install(args: argparse.Namespace) -> dict[str, Any]:
    plan = load_plan(args.plan)
    require_apply_environment(plan)
    require_confirmation(plan, args.approve)
    state = current_state()
    if state and state.get("plan_hash") == plan["plan_hash"] and state.get("status") == "installed" and container_running():
        return {
            "status": "no_op",
            "plan_hash": plan["plan_hash"],
            "health": wait_healthy(plan),
            "resources": require_container_resources(plan["instance"]),
        }
    ensure_directories()
    if not (ETC / "company.json").exists():
        write_secure(ETC / "company.json", canonical(plan["company_profile"]) + b"\n")
    elif json.loads((ETC / "company.json").read_text()) != plan["company_profile"]:
        raise RuntimeError("existing company profile differs from the approved plan")
    if not (ETC / "secret-key").exists():
        write_secure(ETC / "secret-key", secrets.token_urlsafe(48).encode() + b"\n")
    image = build_image(plan)
    if not (APP_DATA / "bizhub.db").exists():
        if not sys.stdin.isatty():
            raise RuntimeError("initial administrator password requires an interactive TTY")
        first = getpass.getpass("Administrator password: ")
        second = getpass.getpass("Repeat administrator password: ")
        if first != second:
            raise RuntimeError("administrator passwords did not match")
        run([
            "docker", "run", "--rm", "-i", *docker_mounts(plan), image,
            "python", "-m", "bizhub.manage", "init", "--username", plan["administrator"]["username"], "--password-stdin",
        ], input_text=first + "\n")
    start_container(plan, image)
    health = wait_healthy(plan)
    resources = require_container_resources(plan["instance"])
    state = {
        "schema_version": 1, "status": "installed", "installed_at": now(), "updated_at": now(),
        "plan_hash": plan["plan_hash"], "source": plan["source"], "instance": plan["instance"],
        "image": image, "health": health, "resources": resources,
    }
    write_state(state)
    return {
        "status": "installed",
        "plan_hash": plan["plan_hash"],
        "health": health,
        "resources": resources,
        "external_steps": plan["external_steps"],
    }


def backup_instance(label: str = "manual") -> dict[str, Any]:
    state = current_state()
    if not state or not container_running():
        raise RuntimeError("BizHub container is not running")
    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%S%fZ")
    name = f"bizhub-{stamp}-{label}.sqlite"
    result = run(["docker", "exec", CONTAINER, "python", "-m", "bizhub.manage", "backup", "--output", f"/backups/{name}"])
    payload = json.loads(result.stdout)
    host = BACKUPS / name
    payload.update({"sha256": file_digest(host), "host_path": str(host)})
    return payload


def verify_instance() -> dict[str, Any]:
    state = current_state()
    if not state:
        raise RuntimeError("install state does not exist")
    result = run(["docker", "exec", CONTAINER, "python", "-m", "bizhub.manage", "verify"])
    health = wait_healthy({"instance": state["instance"]})
    resources = require_container_resources(state["instance"])
    return {"status": "ok", "database": json.loads(result.stdout), "health": health, "resources": resources, "state": state}


def restore_instance(path: Path) -> dict[str, Any]:
    state = current_state()
    if not state:
        raise RuntimeError("install state does not exist")
    source = path.resolve()
    if source.parent != BACKUPS.resolve() or not source.is_file():
        raise ValueError("restore source must be a regular file directly inside the BizHub backup directory")
    safety = backup_instance("before-restore")
    run(["docker", "stop", CONTAINER])
    destination = APP_DATA / "bizhub.db"
    for sidecar in (APP_DATA / "bizhub.db-wal", APP_DATA / "bizhub.db-shm"):
        if sidecar.exists():
            sidecar.unlink()
    temporary = APP_DATA / "bizhub.db.restore"
    shutil.copy2(source, temporary)
    os.chown(temporary, 10001, 10001)
    os.chmod(temporary, 0o600)
    temporary.replace(destination)
    run(["docker", "start", CONTAINER])
    try:
        health = wait_healthy({"instance": state["instance"]})
    except Exception as exc:
        run(["docker", "stop", CONTAINER], check=False)
        shutil.copy2(Path(safety["host_path"]), destination)
        os.chown(destination, 10001, 10001)
        os.chmod(destination, 0o600)
        run(["docker", "start", CONTAINER])
        wait_healthy({"instance": state["instance"]})
        raise RuntimeError(f"restore candidate failed verification; current database was recovered: {exc}") from exc
    return {"status": "restored", "source": str(source), "safety_backup": safety, "health": health}


def update_instance(args: argparse.Namespace) -> dict[str, Any]:
    plan = load_plan(args.plan)
    require_apply_environment(plan)
    require_confirmation(plan, args.approve)
    previous = current_state()
    if not previous:
        raise RuntimeError("install BizHub before updating")
    if previous.get("plan_hash") == plan["plan_hash"] and container_running():
        return {
            "status": "no_op",
            "health": wait_healthy(plan),
            "resources": require_container_resources(plan["instance"]),
        }
    if json.loads((ETC / "company.json").read_text(encoding="utf-8")) != plan["company_profile"]:
        raise RuntimeError("company profile changes are not supported by update")
    backup = backup_instance("before-update")
    old_image = previous["image"]
    image = build_image(plan)
    try:
        start_container(plan, image)
        health = wait_healthy(plan)
        resources = require_container_resources(plan["instance"])
    except Exception:
        if container_exists():
            run(["docker", "rm", "-f", CONTAINER])
        source = Path(backup["host_path"])
        destination = APP_DATA / "bizhub.db"
        for sidecar in (APP_DATA / "bizhub.db-wal", APP_DATA / "bizhub.db-shm"):
            if sidecar.exists():
                sidecar.unlink()
        shutil.copy2(source, destination)
        os.chown(destination, 10001, 10001)
        os.chmod(destination, 0o600)
        rollback_instance = {**previous["instance"], "resource_limits": plan["instance"]["resource_limits"]}
        start_container({"instance": rollback_instance}, old_image)
        wait_healthy({"instance": previous["instance"]})
        raise
    updated = {**previous, "status": "installed", "updated_at": now(), "plan_hash": plan["plan_hash"], "source": plan["source"], "instance": plan["instance"], "image": image, "health": health, "resources": resources}
    write_state(updated)
    return {"status": "updated", "backup": backup, "health": health, "resources": resources}


def uninstall(args: argparse.Namespace) -> dict[str, Any]:
    state = current_state()
    if not state:
        return {"status": "no_op", "retained": [str(DATA), str(BACKUPS)]}
    expected = f"retain-data:{state['plan_hash']}"
    supplied = args.approve or input(f"Type {expected} to stop and remove the application container: ").strip()
    if not secrets.compare_digest(expected, supplied):
        raise RuntimeError("uninstall confirmation did not match")
    if container_exists():
        run(["docker", "rm", "-f", CONTAINER])
    state.update({"status": "uninstalled_data_retained", "updated_at": now()})
    write_state(state)
    return {"status": "uninstalled_data_retained", "retained": [str(ETC), str(DATA), str(BACKUPS)]}


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="bizhubctl", description="BizHub single-instance installer")
    root.add_argument("--version", action="version", version=VERSION)
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("preflight")
    plan = commands.add_parser("plan")
    plan.add_argument("--output", type=Path, default=Path("/tmp/bizhub-install-plan.json"))
    plan.add_argument("--access", choices=["loopback", "private", "domain", "cloudflare"], required=True)
    plan.add_argument("--bind-address", required=True)
    plan.add_argument("--port", type=int, default=8080, choices=range(1024, 65536), metavar="PORT")
    plan.add_argument("--hostname", default="")
    plan.add_argument("--allow-http-private", action="store_true")
    plan.add_argument("--profile-id", required=True)
    plan.add_argument("--legal-name", required=True)
    plan.add_argument("--display-name", required=True)
    plan.add_argument("--brand-mark", required=True)
    plan.add_argument("--timezone", required=True)
    plan.add_argument("--currency", default="CNY")
    plan.add_argument("--admin-username", required=True)
    plan.add_argument("--memory-mib", type=int, default=1024)
    plan.add_argument(
        "--swap-mib",
        type=int,
        default=512,
        help="additional swap allowance; Docker receives memory plus this value as --memory-swap",
    )
    plan.add_argument("--cpu-millicores", type=int, default=1000)
    plan.add_argument("--pids-limit", type=int, default=256)
    plan.add_argument(
        "--candidate-core-image",
        help="local public core image reference used to prove derived filesystem ancestry",
    )
    plan.add_argument(
        "--candidate-image",
        help="local prebuilt customer-private image reference; requires --candidate-core-image",
    )
    for name in ("install", "update"):
        action = commands.add_parser(name)
        action.add_argument("--plan", type=Path, required=True)
        action.add_argument("--approve")
    commands.add_parser("verify")
    commands.add_parser("status")
    backup = commands.add_parser("backup")
    backup.add_argument("--label", default="manual")
    restore = commands.add_parser("restore")
    restore.add_argument("--backup", type=Path, required=True)
    uninstall_parser = commands.add_parser("uninstall")
    uninstall_parser.add_argument("--approve")
    return root


def main() -> None:
    args = parser().parse_args()
    try:
        if args.command == "preflight":
            result = preflight_result()
        elif args.command == "plan":
            result = make_plan(args)
            args.output.write_bytes(canonical(result) + b"\n")
            result = {"status": "planned", "path": str(args.output.resolve()), "plan": result}
        elif args.command == "install":
            result = install(args)
        elif args.command == "verify":
            result = verify_instance()
        elif args.command == "status":
            state = current_state()
            if state is None:
                result = {"status": "absent"}
            else:
                running = container_running()
                result = {
                    "status": state["status"],
                    "container_running": running,
                    "resources": container_resource_status(state["instance"]) if running else None,
                    "state": state,
                }
        elif args.command == "backup":
            result = backup_instance(args.label)
        elif args.command == "restore":
            result = restore_instance(args.backup)
        elif args.command == "update":
            result = update_instance(args)
        else:
            result = uninstall(args)
        emit(result)
        if result.get("status") == "failed":
            raise SystemExit(2)
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as exc:
        detail = str(exc)
        if isinstance(exc, subprocess.CalledProcessError):
            detail = (exc.stderr or exc.stdout or detail).strip()
        emit({"status": "failed", "error": detail})
        raise SystemExit(2) from None


if __name__ == "__main__":
    main()
