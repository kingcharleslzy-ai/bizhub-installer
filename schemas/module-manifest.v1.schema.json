{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kingcharleslzy-ai/bizhub-installer/schemas/module-manifest.v1.schema.json",
  "title": "BizHub module manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "display_name",
    "module_version",
    "source",
    "kind",
    "api_prefix",
    "dependencies",
    "provides_capabilities",
    "requires_capabilities",
    "owns_entities",
    "ui_sections",
    "read_apis",
    "actions",
    "import_resources",
    "governance"
  ],
  "properties": {
    "schema_version": {"const": "bizhub.module-manifest.v1"},
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "module_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "source": {"enum": ["builtin", "customer_private"]},
    "kind": {"enum": ["business", "integration", "experience"]},
    "api_prefix": {"type": "string", "maxLength": 160},
    "dependencies": {"$ref": "#/$defs/stringSet"},
    "provides_capabilities": {"$ref": "#/$defs/stringSet"},
    "requires_capabilities": {"$ref": "#/$defs/stringSet"},
    "owns_entities": {"$ref": "#/$defs/stringSet"},
    "ui_sections": {"$ref": "#/$defs/stringSet"},
    "read_apis": {"$ref": "#/$defs/stringSet"},
    "import_resources": {"$ref": "#/$defs/stringSet"},
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "scope", "mode"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "scope": {"type": "string", "minLength": 1, "maxLength": 80},
          "mode": {"const": "owner_write"}
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_writer",
        "preview_required",
        "readback_required",
        "direct_sql_via_mcp",
        "runtime_activation"
      ],
      "properties": {
        "formal_writer": {"enum": ["none", "module_owner", "delegated_owner"]},
        "preview_required": {"type": "boolean"},
        "readback_required": {"const": true},
        "direct_sql_via_mcp": {"const": false},
        "runtime_activation": {"const": "build_time"}
      },
      "allOf": [
        {
          "if": {"properties": {"formal_writer": {"const": "none"}}},
          "then": {"properties": {"preview_required": {"const": false}}},
          "else": {"properties": {"preview_required": {"const": true}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source": {"const": "customer_private"}}},
      "then": {
        "properties": {
          "module_id": {"pattern": "^customer\\.[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
          "api_prefix": {"pattern": "^/api/extensions/[a-z][a-z0-9-]*(?:/[a-z0-9-]+)*$"}
        }
      },
      "else": {"properties": {"api_prefix": {"const": ""}}}
    },
    {
      "if": {
        "properties": {
          "governance": {
            "properties": {"formal_writer": {"const": "none"}},
            "required": ["formal_writer"]
          }
        }
      },
      "then": {
        "properties": {
          "owns_entities": {"maxItems": 0},
          "actions": {"maxItems": 0},
          "import_resources": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    }
  }
}
